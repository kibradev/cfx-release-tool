<Window x:Class="ReleaseTool.Desktop.Views.PortalSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Portal / Keymaster"
        Width="520"
        Height="460"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Cfx.re Portal entegrasyonu"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Escrow ZIP'i doğrudan portal-api.cfx.re üzerinden yükleyin."
                       FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />
            <TextBlock x:Name="ResourceNameBlock"
                       FontSize="11"
                       Foreground="{StaticResource AccentBrush}"
                       Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <Button Content="Tarayıcıdan giriş yap (önerilen)"
                    Style="{StaticResource PrimaryButton}"
                    Click="BrowserLoginButton_Click"
                    Margin="0,0,0,12" />

            <TextBlock Text="— veya manuel cookie —"
                       FontSize="10"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8" />

            <TextBlock Text="Forum cookie (Network → cookie: satırı)"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,0,0,4" />
            <PasswordBox x:Name="CookieBox"
                         Padding="8,6"
                         Margin="0,0,0,4"
                         ToolTip="Network → cookie: satırının TAMAMINI yapıştırın (önerilen)" />
            <Button Content="Cookie nasıl alınır?"
                    HorizontalAlignment="Left"
                    Style="{StaticResource SmallButton}"
                    Click="HelpButton_Click"
                    Margin="0,0,0,12" />

            <TextBlock Text="Asset ID (Created Assets)"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,0,0,4" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="AssetIdBox"
                         Padding="8,6"
                         ToolTip="portal.cfx.re → Created Assets → ID" />
                <Button Grid.Column="2"
                        x:Name="SearchButton"
                        Content="Ara"
                        Style="{StaticResource SmallButton}"
                        Click="SearchButton_Click" />
            </Grid>
            <TextBox x:Name="SearchBox"
                     Padding="8,6"
                     Margin="0,0,0,8"
                     ToolTip="Portal'da asset adı ile ara" />

            <Button x:Name="TestButton"
                    Content="Bağlantıyı test et"
                    Click="TestButton_Click"
                    Margin="0,0,0,8" />

            <TextBlock x:Name="StatusText"
                       FontSize="11"
                       Foreground="{StaticResource AccentBrush}" />

            <TextBlock Text="Resmi upload API yok — forum cookie ile portal-api kullanılır. Cookie süresi dolunca yenileyin."
                       FontSize="10"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0" />
        </StackPanel>

        <Separator Grid.Row="2" Margin="0,12" Background="{StaticResource BorderBrush}" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Kaydet"
                    Style="{StaticResource PrimaryButton}"
                    Click="SaveButton_Click"
                    Padding="16,8"
                    Margin="0,0,8,0" />
            <Button Content="İptal"
                    Click="CancelButton_Click"
                    Padding="16,8" />
        </StackPanel>
    </Grid>
</Window>
